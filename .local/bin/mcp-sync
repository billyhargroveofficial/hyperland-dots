#!/usr/bin/env python3
"""Нейтральная user-scope обёртка над Rulesync."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


def strip_jsonc(source: str) -> str:
    """Remove JSONC comments while preserving comment markers in strings."""
    result: list[str] = []
    index = 0
    in_string = False
    escaped = False

    while index < len(source):
        char = source[index]
        following = source[index + 1] if index + 1 < len(source) else ""

        if in_string:
            result.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
            continue

        if char == '"':
            in_string = True
            result.append(char)
            index += 1
        elif char == "/" and following == "/":
            index += 2
            while index < len(source) and source[index] not in "\r\n":
                index += 1
        elif char == "/" and following == "*":
            index += 2
            while index + 1 < len(source) and source[index : index + 2] != "*/":
                index += 1
            index += 2
        elif char in "}]":
            previous = len(result) - 1
            while previous >= 0 and result[previous].isspace():
                previous -= 1
            if previous >= 0 and result[previous] == ",":
                result.pop(previous)
            result.append(char)
            index += 1
        else:
            result.append(char)
            index += 1

    return "".join(result)


def configured_targets(config: Path) -> list[str]:
    data = json.loads(strip_jsonc(config.read_text(encoding="utf-8")))
    targets = data.get("targets", {})
    if not isinstance(targets, dict):
        raise ValueError('поле "targets" должно быть объектом')
    return sorted(str(target) for target in targets)


def usage() -> None:
    print(
        "Использование: mcp-sync [--list-targets] [аргументы rulesync generate]\n"
        "\n"
        "Примеры:\n"
        "  mcp-sync --dry-run\n"
        "  mcp-sync\n"
        "  mcp-sync --check\n"
        "  mcp-sync --list-targets"
    )


def main() -> int:
    root = Path(
        os.environ.get("AGENTS_HOME", str(Path.home() / ".config" / "agents"))
    ).expanduser()
    config = root / "rulesync.jsonc"

    if sys.argv[1:] == ["--help"]:
        usage()
        return 0
    if sys.argv[1:] == ["--list-targets"]:
        try:
            targets = configured_targets(config)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            print(f"mcp-sync: не удалось прочитать {config}: {error}", file=sys.stderr)
            return 1
        if targets:
            print("\n".join(targets))
        else:
            print("(targets не заданы)")
        return 0

    if not config.is_file():
        print(f"mcp-sync: не найден {config}", file=sys.stderr)
        return 1

    executable = os.environ.get("RULESYNC_BIN") or shutil.which("rulesync")
    if not executable:
        print("mcp-sync: rulesync не найден в PATH", file=sys.stderr)
        return 127

    command = [
        executable,
        "generate",
        "--global",
        "--input-root",
        str(root),
        "--config",
        str(config),
        *sys.argv[1:],
    ]
    return subprocess.run(command, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
