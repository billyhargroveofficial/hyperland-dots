# Игнорировать всё
*

# ...но разрешить git заходить В каталоги. Без этой строки правила вида
# `!.config/hypr/**` не работают для НОВЫХ файлов: git не спускается внутрь
# каталога, который сам попал под `*`, и не видит, что там что-то разрешено.
# Уже отслеживаемые файлы это не задевало (gitignore на них не действует),
# поэтому дыра годами оставалась незаметной — новые файлы просто молча
# не добавлялись.
!*/

# Но не игнорировать сам .gitignore
!.gitignore

# Явно включаем нужные конфиги
!.zshrc
!.p10k.zsh
!.tmux.conf
!gpu-fan-control.sh
!restore-config.sh
!.config/
!.config/nvim/**
!.config/hypr/**
!.config/kitty/**
!.config/ghostty/**
!.config/rofi/
!.config/rofi/**
!.config/swaykbdd/**
!.config/neofetch/**
!.config/gtk-3.0/**
!.config/gtk-4.0/**
!.config/fontconfig/
!.config/fontconfig/**
!.config/alacritty/**
# tmux: тема из macdots + скрипты (случайные имена окон, индикатор
# AI-агентов во вкладках). Каталог целиком — restore-config.sh делает
# rm -rf перед cp, неполный набор потерял бы rename-random.sh.
!.config/tmux/
!.config/tmux/**
# Дефолтные приложения (браузер для http/https). Одиночный
# файл: без него после восстановления ссылки открывает не Chrome, а что попало.
!.config/mimeapps.list
!.config/scripts/**
!.config/waybar/
!.config/waybar/**
!.config/sing-box/
!.config/sing-box/config.json.example
# Exclude real config with sensitive data
.config/sing-box/config.json
!.config/zellij/
!.config/zellij/**
!.config/swaync/
!.config/swaync/**
!.config/hyprshell/
!.config/hyprshell/**
!.config/wireplumber/
!.config/wireplumber/**
!.config/systemd/
!.config/systemd/user/
# Bluetooth-аудио: автопереключение на наушники и обход бага WirePlumber
# с потерей BlueZ-endpoints (docs/bluetooth-audio.md).
!.config/systemd/user/bt-audio-autoswitch.service
!.config/systemd/user/bt-audio-recover.service
# Обратный SSH-туннель для входа на mujik через loopback-порт nareshka.ru:2223.
!.config/systemd/user/mujik-ssh-tunnel.service
!.config/chrome-flags.conf.template

# AI control plane executables
!.local/
!.local/bin/
!.local/bin/bt-audio-autoswitch
!.local/bin/bt-audio-recover
!.local/bin/mujik-ssh-tunnel
!.local/bin/waybar-mono-icons
!.local/share/
!.local/share/fonts/
!.local/share/fonts/InterTight/
!.local/share/fonts/InterTight/**

# Скрипты установки
!scripts/
!scripts/**

# Локальные и CI-проверки репозитория.
!.github/
!.github/**
!.githooks/
!.githooks/**

# Системные файлы: демоны в /opt, юниты systemd, udev-правила.
# Лежат здесь, а не качаются со стороны, потому что в апстриме их либо нет,
# либо там сломанная версия (см. system/README.md).
!system/
!system/**

# Бэкапы, которые плодят скрипты — в репу им нельзя
*.bak-*
*.removed-*

# Documentation
!README.md
!CLAUDE.md
!AGENTS.md
!PROMPT-INSTALL.md
# Каталог docs/ добавлен 2026-07-26. До этого правила не было вообще, и весь
# каталог молча лежал вне репозитория: `!README.md` вытягивал только
# docs/README.md, а waybar.md, hyprland.md и остальные 27 КБ заметок git не
# видел. Ровно тот же класс дыры, что и с `!*/` выше — правило есть, файлов нет.
!docs/
!docs/**

# Нейтральная документация hooks для tmux-agent-indicator; конкретные
# vendor-вставки в репозитории не хранятся.
!harness-hooks/
!harness-hooks/**
!.config/Code/
!.config/Code/**
# Байткод Python. Каталоги скриптов пропущены в whitelist целиком (`!.config/
# waybar/**`), поэтому без явного правила __pycache__ туда пролезает — его
# создаёт любой запуск модулей waybar и любая проверка через py_compile.
__pycache__/
*.pyc
