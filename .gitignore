# Игнорировать всё
*

# ...но разрешить git заходить В каталоги. Без этой строки правила вида
# `!.config/hypr/**` не работают для НОВЫХ файлов: git не спускается внутрь
# каталога, который сам попал под `*`, и не видит, что там что-то разрешено.
# Уже отслеживаемые файлы это не задевало (gitignore на них не действует),
# поэтому дыра годами оставалась незаметной — новые файлы просто молча
# не добавлялись.
!*/

# Но не игнорировать сам .gitignore
!.gitignore

# Явно включаем нужные конфиги
!.zshrc
!.p10k.zsh
!.tmux.conf
!gpu-fan-control.sh
!restore-config.sh
!.config/
!.config/nvim/**
!.config/hypr/**
!.config/kitty/**
!.config/ghostty/**
!.config/rofi/
!.config/rofi/**
!.config/swaykbdd/**
!.config/neofetch/**
!.config/gtk-3.0/**
!.config/gtk-4.0/**
!.config/alacritty/**
# tmux: тема из macdots + скрипты (случайные имена окон, индикатор
# AI-агентов во вкладках). Каталог целиком — restore-config.sh делает
# rm -rf перед cp, неполный набор потерял бы rename-random.sh.
!.config/tmux/
!.config/tmux/**
# statusline для Claude Code (cship). Одиночный файл, не каталог — маска
# `**` тут не нужна.
!.config/cship.toml
!.config/cship.toml.compact-variant
# Дефолтные приложения (браузер для http/https и схема claude-cli). Одиночный
# файл: без него после восстановления ссылки открывает не Chrome, а что попало.
!.config/mimeapps.list
!.config/scripts/**
!.config/waybar/
!.config/waybar/**
!.config/sing-box/
!.config/sing-box/config.json.example
# Exclude real config with sensitive data
.config/sing-box/config.json
!.config/niri/**
!.config/zellij/
!.config/zellij/**
!.config/swaync/
!.config/swaync/**
!.config/hyprshell/
!.config/hyprshell/**
!.config/wireplumber/
!.config/wireplumber/**
!.config/agents/
!.config/agents/**
.config/agents/secrets.env
.config/agents/qwen-service.env
.config/agents/telegram-service.env
.config/agents/AGENTS.md
.config/agents/mcp.json
.config/agents/skills
!.config/systemd/
!.config/systemd/user/
!.config/systemd/user/qwen-serve.service
!.config/systemd/user/qwen-channel-telegram.service
!.config/systemd/user/telegram-mcp.service
# Bluetooth-аудио: автопереключение на наушники и обход бага WirePlumber
# с потерей BlueZ-endpoints (docs/bluetooth-audio.md).
!.config/systemd/user/bt-audio-autoswitch.service
!.config/systemd/user/bt-audio-recover.service
# Hermes Agent (Telegram gateway). PATH в юните обязателен: без него
# stdio-MCP из ~/.local/bin не стартуют.
!.config/systemd/user/hermes-agent.service
!.config/chrome-flags.conf.template

# AI control plane executables and Grok base config
!.local/
!.local/bin/
!.local/bin/mcp-sync
!.local/bin/gemini-search-mcp
!.local/bin/bt-audio-autoswitch
!.local/bin/bt-audio-recover
!.local/bin/cship-wrap
!.local/bin/hermes
!.grok/
!.grok/config.toml

# Pi: только описание провайдера Alibaba Token Plan (ключ — ссылкой на
# $BAILIAN_TOKEN_PLAN_API_KEY). Остальное в ~/.pi/agent/ — auth.json,
# сессии, установленные npm-расширения — runtime, в репо ему нельзя.
!.pi/
!.pi/agent/
!.pi/agent/models.json

# Скрипты установки
!scripts/
!scripts/**

# Системные файлы: демоны в /opt, юниты systemd, udev-правила.
# Лежат здесь, а не качаются со стороны, потому что в апстриме их либо нет,
# либо там сломанная версия (см. system/README.md).
!system/
!system/**

# Бэкапы, которые плодят скрипты — в репу им нельзя
*.bak-*
*.removed-*

# Documentation
!README.md
!CLAUDE.md
!AGENTS.md
# Каталог docs/ добавлен 2026-07-26. До этого правила не было вообще, и весь
# каталог молча лежал вне репозитория: `!README.md` вытягивал только
# docs/README.md, а waybar.md, hyprland.md и остальные 27 КБ заметок git не
# видел. Ровно тот же класс дыры, что и с `!*/` выше — правило есть, файлов нет.
!docs/
!docs/**

# Хуки харнессов для tmux-agent-indicator: фрагменты конфигов, которые
# правятся вручную (сами конфиги харнессов не версионируются).
!harness-hooks/
!harness-hooks/**
!.config/Code/
!.config/Code/**
# OpenCode: версионируется только выбор темы TUI (прозрачный фон = тема
# терминала). Остальное НЕ включаем намеренно: opencode.json содержит MCP и
# частично генерится mcp-sync (AGENTS.md, skills), node_modules — runtime.
# Маска узкая, без `**`, чтобы будущий `git add .` не затащил runtime/generated.
!.config/opencode/tui.json

# Байткод Python. Каталоги скриптов пропущены в whitelist целиком (`!.config/
# waybar/**`), поэтому без явного правила __pycache__ туда пролезает — его
# создаёт любой запуск модулей waybar и любая проверка через py_compile.
__pycache__/
*.pyc
