font-family = "MapleMono NF CN"
font-size = 20
window-inherit-font-size = false
window-padding-x = 25
window-padding-y = 25

window-width = 1200
window-height = 750

window-decoration = false

# Catppuccin Mocha colors

cursor-style = block
cursor-style-blink = true


scrollback-limit = 50000

# Clipboard
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+shift+c=text:\x03
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Вставка картинок в терминальные AI-клиенты.
# Они слушают Ctrl+V (0x16) и сами читают буфер через wl-paste,
# но ghostty съедает ctrl+v выше и шлёт только текст. Alt+V отдаёт
# приложению сырой ^V — оно достаёт из буфера картинку само.
keybind = alt+v=text:\x16

# Windows
keybind = ctrl+shift+n=new_window
keybind = alt+f4=close_window

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=last_tab

# Font size
keybind = ctrl+plus=increase_font_size:2
keybind = ctrl+minus=decrease_font_size:2
keybind = ctrl+0=reset_font_size

# Scroll
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom

keybind = f11=toggle_fullscreen
keybind = ctrl+shift+f=toggle_fullscreen

mouse-hide-while-typing = true
confirm-close-surface = false
auto-update = off
copy-on-select = true

unfocused-split-opacity = 1

keybind = shift+insert=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard
background-blur = true

# Тема: ghostty сам следит за org.freedesktop.appearance color-scheme
# и переключает light/dark вживую, без перезапуска и без правки конфига.
# Цвета лежат в ~/.config/ghostty/themes/gruvbox-mine-{light,dark}
theme = light:gruvbox-mine-light,dark:gruvbox-mine-dark
window-theme = auto
