[Unit]
Description=Hermes Agent (Telegram gateway)
After=network.target telegram-mcp.service
Wants=telegram-mcp.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/hermes-agent
# systemd не наследует PATH из шелла, а stdio-MCP (chrome-devtools-mcp,
# gemini-search-mcp) живут в ~/.local/bin — без этого они падают с
# FileNotFoundError и Hermes уходит в телегу без браузера и поиска.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:%h/.cargo/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl
EnvironmentFile=%h/.hermes/.env
# --extra mcp обязателен: без него MCP SDK не ставится и Hermes молча
# работает вообще без MCP-тулов. --extra cli — меню для слэш-команд.
ExecStart=%h/.local/bin/uv run --extra mcp --extra cli --inexact python cli.py --gateway telegram
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
