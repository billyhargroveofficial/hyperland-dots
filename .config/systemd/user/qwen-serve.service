[Unit]
Description=Qwen Code daemon (loopback HTTP + SSE)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=%h/.config/agents/qwen-service.env
ExecStart=/usr/bin/env qwen serve --hostname 127.0.0.1 --port 4170 --workspace %h
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
