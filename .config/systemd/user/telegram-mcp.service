[Unit]
Description=Telegram MCP server (shared streamable HTTP, one Telegram connection)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/telegram-mcp
EnvironmentFile=%h/.config/agents/telegram-service.env
ExecStart=/usr/bin/env uv run main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
