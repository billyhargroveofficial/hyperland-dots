[Unit]
Description=Qwen Code Telegram channel
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=%h/.config/agents/qwen-service.env
ExecStart=/usr/bin/env qwen channel start telegram
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
