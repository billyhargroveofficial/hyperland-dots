{
  "layer": "top",
  "position": "top",
  "margin-top": 20,
  "margin-bottom": 10,
  "margin-left": 40,
  "margin-right": 40,
  "modules-left": [
    "group/workspaces-island",
    "group/accent"
  ],
  "modules-center": [
    "image#telemetry-cpu",
    "custom/telemetry-cpu",
    "image#telemetry-gpu",
    "custom/telemetry-gpu",
    "image#telemetry-ram",
    "custom/telemetry-ram",
    "image#telemetry-vram",
    "custom/telemetry-vram",
    "image#telemetry-ssd",
    "custom/telemetry-ssd"
  ],
  "modules-right": [
    "tray",
    "image#network",
    "image#vpn",
    "hyprland/language",
    "image#bluetooth",
    "image#volume",
    "pulseaudio/slider",
    "image#brightness",
    "custom/brightness",
    "image#wallpaper",
    "image#recorder",
    "clock",
    "custom/power-button"
  ],
  "group/workspaces-island": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/workspaces"
    ]
  },
  "group/accent": {
    "orientation": "horizontal",
    "modules": [
      "image#accent-purple",
      "image#accent-blue",
      "image#accent-teal",
      "image#accent-amber",
      "image#theme-toggle"
    ]
  },
  "image#accent-purple": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh accent purple",
    "size": 17,
    "signal": 12,
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/accent.sh set purple"
  },
  "image#accent-blue": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh accent blue",
    "size": 17,
    "signal": 12,
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/accent.sh set blue"
  },
  "image#accent-teal": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh accent teal",
    "size": 17,
    "signal": 12,
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/accent.sh set teal"
  },
  "image#accent-amber": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh accent amber",
    "size": 17,
    "signal": 12,
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/accent.sh set amber"
  },
  "image#theme-toggle": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh theme",
    "size": 16,
    "signal": 12,
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/toggle-theme.sh"
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU",
    "tooltip": false
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
    "expand": false
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "icons": {
      "TelegramDesktop": "waybar-tray-telegram",
      "nm-applet": "waybar-tray-network",
      "tray-icon tray app flov-tray": "waybar-tray-flov"
    }
  },
  "clock": {
    "format": "{:%d.%m.%Y   %H:%M}",
    "tooltip": false
  },
  "image#telemetry-cpu": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh path cpu",
    "size": 15,
    "signal": 12,
    "tooltip": false
  },
  "custom/telemetry-cpu": {
    "exec": "~/.config/waybar/scripts/telemetry.py cpu",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },
  "image#telemetry-gpu": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh path gpu",
    "size": 16,
    "signal": 12,
    "tooltip": false
  },
  "custom/telemetry-gpu": {
    "exec": "~/.config/waybar/scripts/telemetry.py gpu",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },
  "image#telemetry-ram": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh path memory-stick",
    "size": 16,
    "signal": 12,
    "tooltip": false
  },
  "custom/telemetry-ram": {
    "exec": "~/.config/waybar/scripts/telemetry.py ram",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": false,
    "hide-empty-text": true
  },
  "image#telemetry-vram": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh path microchip",
    "size": 15,
    "signal": 12,
    "tooltip": false
  },
  "custom/telemetry-vram": {
    "exec": "~/.config/waybar/scripts/telemetry.py vram",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },
  "image#telemetry-ssd": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh path hard-drive",
    "size": 16,
    "signal": 12,
    "tooltip": false
  },
  "custom/telemetry-ssd": {
    "exec": "~/.config/waybar/scripts/telemetry.py ssd",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },
  "image#network": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh network",
    "size": 16,
    "interval": 3,
    "signal": 12,
    "tooltip": false
  },
  "image#vpn": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh vpn",
    "size": 15,
    "interval": 3,
    "signal": 12,
    "tooltip": false
  },
  "image#bluetooth": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh bluetooth",
    "size": 15,
    "interval": 5,
    "signal": 12,
    "tooltip": false,
    "on-click": "blueman-manager"
  },
  "image#volume": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh volume",
    "size": 16,
    "interval": 2,
    "signal": 12,
    "tooltip": false,
    "on-click": "pavucontrol"
  },
  "image#brightness": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh path sun",
    "size": 16,
    "signal": 12,
    "tooltip": false,
    "on-scroll-up": "~/.config/hypr/scripts/brightness.sh up",
    "on-scroll-down": "~/.config/hypr/scripts/brightness.sh down"
  },
  "image#recorder": {
    "exec": "~/.config/waybar/scripts/svg-icons.sh recorder",
    "size": 16,
    "interval": 30,
    "signal": 10,
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/recorder.sh"
  },
  "image#wallpaper": {
    "exec": "~/.config/waybar/scripts/video-wallpaper-icon.sh",
    "size": 16,
    "interval": 5,
    "signal": 11,
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/video-wallpaper.sh toggle"
  },
  "custom/power-button": {
    "format": " ",
    "tooltip": false,
    "on-click": "bash ~/.config/waybar/scripts/leave.sh"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "tooltip": false,
    "format-icons": {
      "active": " ",
      "visible": " ",
      "persistent": " ",
      "empty": " ",
      "default": " "
    },
    "all-outputs": false,
    "show-special": false,
    "sort-by": "number",
    "on-scroll-up": "hyprctl dispatch '(function() hyprWsCycle(1) return hl.dsp.no_op() end)()'",
    "on-scroll-down": "hyprctl dispatch '(function() hyprWsCycle(-1) return hl.dsp.no_op() end)()'"
  },
  "custom/brightness": {
    "exec": "~/.config/hypr/scripts/brightness.sh get",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "format": "{}",
    "tooltip": false,
    "on-scroll-up": "~/.config/hypr/scripts/brightness.sh up",
    "on-scroll-down": "~/.config/hypr/scripts/brightness.sh down"
  }
}
