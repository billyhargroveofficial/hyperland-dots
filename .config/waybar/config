{
  "layer": "top",
  "position": "top",
  "margin-top": 20,
  "margin-bottom": 10,
  "margin-left": 40,
  "margin-right": 40,
  "modules-left": [
    "group/workspaces-island",
    "group/accent"
  ],
  "modules-center": [
    "custom/telemetry"
  ],
  "modules-right": [
    "tray",
    "network",
    "custom/singbox",
    "hyprland/language",
    "bluetooth",
    "pulseaudio",
    "pulseaudio/slider",
    "custom/brightness",
    "custom/recorder",
    "clock",
    "custom/power"
  ],
  "group/workspaces-island": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/workspaces"
    ]
  },
  "group/accent": {
    "orientation": "horizontal",
    "modules": [
      "custom/accent-purple",
      "custom/accent-blue",
      "custom/accent-teal",
      "custom/accent-amber",
      "custom/theme-toggle"
    ]
  },
  "custom/accent-purple": {
    "exec": "~/.config/waybar/scripts/accent.sh status purple",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/accent.sh set purple"
  },
  "custom/accent-blue": {
    "exec": "~/.config/waybar/scripts/accent.sh status blue",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/accent.sh set blue"
  },
  "custom/accent-teal": {
    "exec": "~/.config/waybar/scripts/accent.sh status teal",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/accent.sh set teal"
  },
  "custom/accent-amber": {
    "exec": "~/.config/waybar/scripts/accent.sh status amber",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/accent.sh set amber"
  },
  "custom/theme-toggle": {
    "exec": "~/.config/waybar/scripts/accent.sh theme-status",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.config/hypr/scripts/toggle-theme.sh"
  },
  "custom/sep": {
    "format": "|",
    "tooltip": false
  },
  "custom/sep2": {
    "format": "|",
    "tooltip": false
  },
  "custom/sep3": {
    "format": "|",
    "tooltip": false
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU"
  },
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  {volume}%",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    }
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
    "expand": false
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "tooltip-format": "{essid} ({signalStrength}%)",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },
  "bluetooth": {
    "format": "󰂯  {status}",
    "on-click": "blueman-manager",
    "format-disabled": "",
    "format-connected": "󰂱  {num_connections}",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias} {controller_address}"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "icons": {
      "TelegramDesktop": "waybar-tray-telegram",
      "nm-applet": "waybar-tray-network",
      "tray-icon tray app flov-tray": "waybar-tray-flov"
    }
  },
  "clock": {
    "format": "󰃰  {:%d.%m.%Y   %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
  },
  "custom/telemetry": {
    "exec": "~/.config/waybar/scripts/telemetry.py",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": true
  },
  "custom/cpu-temp": {
    "exec": "sensors k10temp-pci-00c3 | grep 'Tctl:' | awk '{print $2}' | sed 's/+//;s/°C//'",
    "format": "󰔏  {}°C",
    "interval": 5
  },
  "custom/gpu-temp": {
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
    "format": "󰢮  {}°C",
    "interval": 5
  },
  "custom/gpu-fan": {
    "exec": "nvidia-smi --query-gpu=fan.speed --format=csv,noheader,nounits",
    "format": "󰈐  {}%",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "GPU Fan Speed"
  },
  "custom/gpu-vram": {
    "exec": "nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits | awk -F', ' '{printf \"%.1f/%.1fG\", $1/1024, $2/1024}'",
    "format": "󰍛  {}",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "GPU VRAM Usage"
  },
  "custom/fan": {
    "exec": "sensors asusec-isa-000a | grep 'Chipset:' | awk 'NR==1{print $2}' | sed 's/RPM//'",
    "format": "󰈐  {} RPM",
    "interval": 5
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.py",
    "return-type": "json",
    "interval": 3,
    "format": "{}",
    "tooltip": true
  },
  "custom/memory": {
    "exec": "~/.config/waybar/scripts/memory.py",
    "return-type": "json",
    "interval": 10,
    "format": "{}",
    "tooltip": true
  },
  "custom/disk": {
    "exec": "~/.config/waybar/scripts/disk.py /home",
    "return-type": "json",
    "interval": 60,
    "format": "{}",
    "tooltip": true
  },
  "custom/recorder": {
    "exec": "~/.config/waybar/scripts/recorder.sh status",
    "return-type": "json",
    "interval": 30,
    "signal": 10,
    "on-click": "~/.config/waybar/scripts/recorder.sh",
    "format": "{}"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "bash ~/.config/waybar/scripts/leave.sh",
    "tooltip": "Power Menu"
  },
  "hyprland/workspaces": {
    "format": "{icon}{windows}",
    "format-icons": {
      "active": " ",
      "visible": " ",
      "persistent": " ",
      "empty": " ",
      "default": " "
    },
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": true,
      "format": "{icon}",
      "icon-size": 16,
      "icon-theme": [
        "WaybarMono"
      ],
      "on-click-window": "hyprctl eval 'local target = hl.get_window(\"address:{address}\"); if target then return hl.dispatch(hl.dsp.focus({ window = target })) end'"
    },
    "all-outputs": false,
    "show-special": false,
    "sort-by": "number",
    "on-scroll-up": "hyprctl dispatch '(function() hyprWsCycle(1) return hl.dsp.no_op() end)()'",
    "on-scroll-down": "hyprctl dispatch '(function() hyprWsCycle(-1) return hl.dsp.no_op() end)()'"
  },
  "custom/singbox": {
    "exec": "~/.config/waybar/scripts/singbox-status.sh",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/singbox-toggle.sh",
    "format": "{}",
    "tooltip": true
  },
  "custom/brightness": {
    "exec": "~/.config/hypr/scripts/brightness.sh get",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "format": "{}",
    "tooltip": true,
    "on-scroll-up": "~/.config/hypr/scripts/brightness.sh up",
    "on-scroll-down": "~/.config/hypr/scripts/brightness.sh down"
  }
}
