# cship — statusline для Claude Code
# папка ● модель · усилие · контекст ● 5h + таймер ● 7d + таймер
# бинарь: ~/.local/bin/cship   |   референс: https://cship.dev

[cship]
lines = ["$cship.workspace.current_dir[ ● ](fg:#565f89)$cship.model$cship.effort$cship.context_window.used_tokens[ ● ](fg:#565f89)$cship.usage_limits"]

[cship.workspace]
format = "[$value]($style)"
style  = "fg:#7aa2f7 bold"

[cship.model]
format = "[$value]($style)"
style  = "fg:#c0caf5 bold"

[cship.effort]
format = "[ · ](fg:#565f89)[$value]($style)"
style  = "fg:#bb9af7"

[cship.context_window.used_tokens]
format      = "[ · ](fg:#565f89)[$value]($style)"
style       = "fg:#7dcfff"
warn_threshold     = 60.0
warn_style         = "fg:#e0af68"
critical_threshold = 85.0
critical_style     = "fg:#f7768e bold"

[cship.usage_limits]
five_hour_format = "5h {pct}% · {reset}"
seven_day_format = "7d {pct}% · {reset}"
separator        = " ● "
style            = "fg:#9ece6a"
warn_threshold     = 70.0
warn_style         = "fg:#e0af68"
critical_threshold = 90.0
critical_style     = "fg:#f7768e bold"
