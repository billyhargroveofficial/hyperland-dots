/* Borderless application launcher; colors.rasi follows system theme/accent. */

@import "colors.rasi"

* {
    bg: @rofi-bg;
    bg-alt: @rofi-surface;
    bg-hover: @rofi-hover;
    fg: @rofi-fg;
    fg-alt: @rofi-fg-dim;
    accent: @rofi-accent;
    accent-alt: @rofi-accent-hover;
    urgent: @rofi-urgent;

    background-color: transparent;
    text-color: @fg;
    font: "SF Pro Display, Semi-Bold 12";
}

window {
    transparency: "real";
    background-color: @bg;
    border: 0px;
    border-radius: 16px;
    padding: 20px;
    width: 650px;
    height: 450px;
}

mainbox {
    spacing: 15px;
    children: [inputbar, listview];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 12px 15px;
    spacing: 12px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    font: "SF Pro Display, Bold 14";
}

entry {
    placeholder: "Search apps...";
    placeholder-color: @rofi-placeholder;
}

listview {
    columns: 1;
    lines: 8;
    spacing: 8px;
    scrollbar: false;
}

element {
    background-color: transparent;
    border-radius: 10px;
    padding: 10px 15px;
    spacing: 15px;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @accent;
    text-color: @rofi-selected-fg;
}

element alternate.normal {
    background-color: transparent;
}

element-icon {
    size: 36px;
    vertical-align: 0.5;
    background-color: inherit;
}

element-text {
    vertical-align: 0.5;
    font: "SF Pro Display, Semi-Bold 12";
    background-color: inherit;
    text-color: inherit;
}

scrollbar {
    handle-color: @accent;
    handle-width: 5px;
    border-radius: 5px;
}
