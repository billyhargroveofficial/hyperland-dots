/* Gruvbox Dark - Wallpaper Selector */

* {
    bg: #282828;
    bg-alt: #3c3836;
    fg: #ebdbb2;
    accent: #a89984;
    accent-alt: #bdae93;
    urgent: #cc241d;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border: 3px solid;
    border-color: @accent;
    border-radius: 16px;
    padding: 20px;
    width: 900px;
    height: 700px;
}

mainbox {
    spacing: 15px;
    children: [inputbar, listview];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 12px;
    spacing: 10px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Search...";
    placeholder-color: #665c54;
}

listview {
    columns: 4;
    lines: 4;
    spacing: 15px;
    fixed-columns: true;
    fixed-height: true;
}

element {
    orientation: vertical;
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 10px;
    spacing: 8px;
    cursor: pointer;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-icon {
    size: 140px;
    horizontal-align: 0.5;
    border-radius: 8px;
}

element-text {
    horizontal-align: 0.5;
    font: "JetBrainsMono Nerd Font 9";
}
