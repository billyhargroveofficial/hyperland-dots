/* Borderless power menu; colors.rasi follows system theme/accent. */

@import "colors.rasi"

* {
    bg: @rofi-bg;
    bg-alt: @rofi-surface;
    fg: @rofi-fg;
    accent: @rofi-accent;

    background-color: transparent;
    text-color: @fg;
    font: "SF Pro Display, Semi-Bold 12";
}

window {
    transparency: "real";
    background-color: @bg;
    border: 0px;
    border-radius: 16px;
    padding: 20px;
    width: 320px;
    location: center;
    anchor: center;
}

mainbox {
    spacing: 15px;
    children: [message, listview];
}

message {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 12px;
}

textbox {
    horizontal-align: 0.5;
    text-color: @accent;
    font: "SF Pro Display, Bold 14";
}

listview {
    columns: 4;
    lines: 1;
    spacing: 10px;
    fixed-columns: true;
}

element {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 15px 10px;
    cursor: pointer;
}

element selected {
    background-color: @accent;
    text-color: @rofi-selected-fg;
}

element-text {
    horizontal-align: 0.5;
    font: "JetBrainsMono Nerd Font 22";
    background-color: inherit;
    text-color: inherit;
}
